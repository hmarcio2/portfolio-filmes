# Copie para .env (na VPS: /opt/apps/filmes/.env). Nunca versione o .env.
# ---- Embeddings (mesma regra do Chatbot) ----
# Vazio = automático: Ollama se LOCAL_EMBEDDING_ENABLED, Google se houver GOOGLE_API_KEY, senão hash (sem semântica).
EMBEDDING_PROVIDER=google_genai
EMBEDDING_MODEL=gemini-embedding-001
LOCAL_EMBEDDING_ENABLED=false

# ---- LLM (mesma regra do projeto Chatbot) ----
# LLM_PROVIDER: google_genai | anthropic | openai | ollama | auto
LLM_PROVIDER=google_genai
# Vazio = modelo mínimo do provedor (google_genai: gemini-flash-lite-latest).
LLM_MODEL=gemini-flash-lite-latest
LLM_TEMPERATURE=0.3
# Preencha só a chave do provedor escolhido e defina um LIMITE DE GASTO no console do provedor.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Reserva local (Ollama): deixe desligado na VPS (sem GPU).
LOCAL_LLM_ENABLED=false

# ---- Proteção de custo e abuso ----
PORTFOLIO_RATE_LIMIT_PER_MINUTE=10
PORTFOLIO_DAILY_MESSAGE_CAP=300

# ---- Langfuse (tracing opcional: sem as chaves, nada é enviado) ----
# Veja o README do portfolio-langfuse. Use as chaves do PROJETO Langfuse deste app (uma por app: isola os dados).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Na VPS (rede "edge"): http://langfuse-web:3000. Local: http://localhost:3300. Cloud: https://cloud.langfuse.com
LANGFUSE_BASE_URL=http://langfuse-web:3000
LANGFUSE_TRACING_ENVIRONMENT=production
# Privacidade: e-mails, CPF e telefones já são mascarados antes do envio. false = só métricas, sem textos.
LANGFUSE_CAPTURE_CONTENT=true
LANGFUSE_SAMPLE_RATE=1.0

# ---- Catálogo ----
# sample (44 filmes em português), cmu (scripts/prepare_cmu.py, em inglês) ou tmdb (scripts/fetch_tmdb.py).
# Sem isto vale o primeiro arquivo que existir: tmdb, cmu, amostra. Idioma das sinopses: PORTFOLIO_FILMES_CATALOG_LANG (pt/en).
PORTFOLIO_FILMES_CATALOG=
